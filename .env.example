# All values are read by the server at runtime (no rebuild needed):
# one image can serve many blogs, each container gets its own environment.

# Required: blog owner - a Hive account or community (hive-XXXXXX).
# Validated at startup; an invalid name stops the server.
HIVE_USERNAME=hive-123456

# Required: public origin of the blog (canonical links, SEO)
PUBLIC_SITE_URL=https://your-community.example.com

# Optional PUBLIC_* settings below; defaults are used when unset.

# Hive API endpoint (default: https://api.openhive.network, with mainnet fallbacks)
# PUBLIC_HIVE_API_ENDPOINT=https://api.openhive.network

# Hive chain ID (default: mainnet; any other value enables testnet mode with WIF login)
# PUBLIC_HIVE_CHAIN_ID=beeab0de00000000000000000000000000000000000000000000000000000000

# Hive image proxy (default: https://images.hive.blog)
# PUBLIC_HIVE_IMAGES_ENDPOINT=https://images.hive.blog

# Beeyard URL (default: https://beeyard.bard-dev.com)
# PUBLIC_BEEYARD_URL=https://beeyard.bard-dev.com

# Hive blog frontend URL for profile/post links (default: PUBLIC_BEEYARD_URL)
# PUBLIC_HIVE_BLOG_URL=https://blog.openhive.network

# Hive Signer URL (default: https://signer.bard-dev.com)
# PUBLIC_HIVE_SIGNER_URL=https://signer.bard-dev.com

# Blog settings from the admin panel live on-chain under a fixed permlink
# on the owner's account - no variable needed.
