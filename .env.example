# Hive community name (must be hive-XXXXXX format)
HIVE_USERNAME=hive-123456

# Hive API endpoint (default: https://api.openhive.network)
# PUBLIC_HIVE_API_ENDPOINT=https://api.openhive.network

# Hive image proxy (default: https://images.hive.blog)
# PUBLIC_HIVE_IMAGES_ENDPOINT=https://images.hive.blog

# Hive blog frontend URL for usertag/hashtag links
# PUBLIC_HIVE_BLOG_URL=https://blog.openhive.network

# Hive chain ID (default: mainnet)
# PUBLIC_HIVE_CHAIN_ID=beeab0de00000000000000000000000000000000000000000000000000000000

# Hive Signer URL
# PUBLIC_HIVE_SIGNER_URL=https://signer.bard-dev.com

# Config storage (where community configs are stored on Hive)
# CONFIG_PARENT_AUTHOR=barddev
# CONFIG_PARENT_PERMLINK=my-blog-configs

# Site URL (for SEO)
# PUBLIC_SITE_URL=https://your-community.example.com
