import "../styles/global.css";
import "../styles/fonts.css";
import NodeSwitcher from "../components/ui/NodeSwitcher.tsx";
import { AuthHeader } from "../components/auth/AuthHeader";
import { DevConfigReapply } from "../components/dev/DevConfigReapply";
import { DevModeBanner } from "../components/dev/DevModeBanner";
import { load_config_with_status } from "../lib/config-pipeline";
import {
  type ThemeColors,
  get_default_settings,
} from "../components/admin/types";
import {
  find_theme_preset,
  resolve_theme_colors,
} from "../components/admin/types/theme";
import {
  get_runtime_config,
  get_site_url,
  hive_avatar_url,
  is_community,
  RUNTIME_CONFIG_ELEMENT_ID,
  serialize_client_runtime_config,
} from "../lib/config";
import { is_dark_color } from "../shared/utils/color";
import { theme_color_vars_to_css } from "../lib/theme-color-vars";
import { parse_custom_colors } from "../components/admin/types/layout-shape";
import {
  build_style_token_vars,
  resolve_font_id,
  style_token_vars_to_css,
  type StyleTokenSettings,
} from "../lib/style-tokens";
import type { FontId } from "../components/admin/types/settings";
import { resolve_head_meta, type HeadMetaSettings } from "../lib/head-meta";
import {
  SITE_TOPBAR_CLASS,
  SITE_TOPBAR_ROW_CLASS,
  renderSiteTopbar,
} from "../shared/components/navigation/render";
import type { NavSourceSettings } from "../shared/components/navigation/utils";
import interUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import sourceSerifUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import spaceGroteskUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import jetbrainsMonoUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import atkinsonUrl from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";

interface SettingsWithTheme extends StyleTokenSettings, HeadMetaSettings {
  siteTheme?: string;
  customColors?: ThemeColors | null;
}

// Latin subset only: the same files fonts.css references, so the preload hits the cache instead of a second download
const HEADING_FONT_PRELOAD: Readonly<Record<FontId, string | null>> = {
  system: null,
  inter: interUrl,
  "source-serif": sourceSerifUrl,
  fraunces: frauncesUrl,
  "space-grotesk": spaceGroteskUrl,
  "jetbrains-mono": jetbrainsMonoUrl,
  atkinson: atkinsonUrl,
};

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  settings?: SettingsWithTheme | null;
  /** /admin: the full-screen editor owns login and the node switcher; no blog nav, style tokens or page container. */
  editorShell?: boolean;
  /** Top bar site name; falls back to `title`. */
  siteName?: string;
  /** Owner links + in_nav pages shown in the top bar (same renderer as the /admin canvas). */
  nav?: NavSourceSettings;
  /** Slug of the current static page, marked aria-current in the top bar nav. */
  activePage?: string;
}

const runtimeConfig = get_runtime_config();
const runtimeConfigJson = serialize_client_runtime_config(runtimeConfig);
const hiveUsername = runtimeConfig.hive_username;

function build_canonical_url(): string {
  const site_url = get_site_url();
  if (site_url) {
    try {
      return new URL(Astro.url.pathname, site_url).href;
    } catch {
      // Invalid PUBLIC_SITE_URL: fall back to the request URL
    }
  }
  return `${Astro.url.origin}${Astro.url.pathname}`;
}

// Default description includes username if available
const defaultDescription = hiveUsername
  ? `${hiveUsername} Community`
  : "A community powered by Hive blockchain";

const {
  title,
  description: descriptionProp,
  ogImage,
  canonicalUrl = build_canonical_url(),
  settings: propsSettings,
  editorShell = false,
  siteName,
  nav,
  activePage,
} = Astro.props;

const topbarHtml = renderSiteTopbar({
  site_name: siteName || title,
  nav,
  active_page: activePage,
});

// Default to community theme colors
const mode_defaults = get_default_settings(true);
let themeColors: ThemeColors = resolve_theme_colors(mode_defaults.siteTheme);

// Pages that already loaded the config pass it in; otherwise the same pipeline is used here
let settings = propsSettings;

if (!settings && hiveUsername) {
  const loaded = await load_config_with_status(
    hiveUsername,
    is_community(hiveUsername),
  );
  if (loaded.status === "error") {
    // Public pages stay up with the default theme when the config cannot be read
    console.error(
      `[Layout] config read failed, rendering default theme: ${loaded.error.message}`,
    );
  } else {
    settings = loaded.settings;
  }
}

if (settings) {
  const preset = find_theme_preset(settings.siteTheme || "light");
  if (preset) {
    themeColors = preset.colors;
  }

  const custom_colors = parse_custom_colors(settings.customColors ?? null);
  if (custom_colors.ok && custom_colors.value) themeColors = custom_colors.value;
}

const nonce = Astro.locals.nonce;

const head = resolve_head_meta({
  settings,
  description: descriptionProp,
  default_description: defaultDescription,
  og_image: ogImage,
  fallback_favicon: hiveUsername
    ? { href: hive_avatar_url(hiveUsername), type: "image/png" }
    : { href: "/favicon.svg", type: "image/svg+xml" },
});
const { description, favicon } = head;
const ogImageMeta = head.og_image;

// Build inline style string for CSS variables
const themeStyle = `${theme_color_vars_to_css(themeColors)} ${style_token_vars_to_css(build_style_token_vars(settings ?? {}))}`;
const headingFontPreload =
  HEADING_FONT_PRELOAD[
    resolve_font_id(settings?.fontHeading, mode_defaults.fontHeading)
  ];
const themeMode = is_dark_color(themeColors.bg) ? "dark" : "light";
---

<!doctype html>
<html lang={head.lang} style={themeStyle} data-theme-mode={themeMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Runtime per-blog config for client code (src/lib/config.ts); data only, never executed -->
    <script
      is:inline
      type="application/json"
      id={RUNTIME_CONFIG_ELEMENT_ID}
      set:html={runtimeConfigJson}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon: seo.favicon via the image proxy, else the Hive avatar -->
    <link rel="icon" type={favicon.type ?? undefined} href={favicon.href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageMeta && <meta property="og:image" content={ogImageMeta.url} />}
    {
      ogImageMeta?.alt && (
        <meta property="og:image:alt" content={ogImageMeta.alt} />
      )
    }

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={ogImageMeta ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageMeta && <meta name="twitter:image" content={ogImageMeta.url} />}
    {
      ogImageMeta?.alt && (
        <meta name="twitter:image:alt" content={ogImageMeta.alt} />
      )
    }

    <!-- Theme Color (for mobile browsers) -->
    <meta name="theme-color" content={themeColors.primary} />

    {
      headingFontPreload && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={headingFontPreload}
          crossorigin
        />
      )
    }

    <!-- Image fallbacks via data attributes: the CSP forbids inline onerror handlers -->
    <script is:inline nonce={nonce}>
      document.addEventListener(
        "error",
        function (e) {
          const img = e.target;
          if (!(img instanceof HTMLImageElement)) return;
          if (img.dataset.fallback === "hide") {
            img.style.display = "none";
          } else if (
            img.dataset.fallbackSrc &&
            img.getAttribute("src") !== img.dataset.fallbackSrc
          ) {
            img.src = img.dataset.fallbackSrc;
          }
        },
        true,
      );
    </script>
  </head>
  <body
    class:list={[
      "bg-bg text-text min-h-screen transition-colors duration-300",
      !editorShell && "style-tokens",
    ]}
  >
    {
      editorShell ? (
        <>
          <slot />
          {import.meta.env.DEV && (
            <DevModeBanner client:only="solid-js" placement="editor" />
          )}
        </>
      ) : (
        <>
          <header class={`${SITE_TOPBAR_CLASS} sticky top-0 z-40`}>
            <div class={SITE_TOPBAR_ROW_CLASS}>
              <Fragment set:html={topbarHtml} />
              {head.show_login && <AuthHeader client:only="solid-js" />}
            </div>
          </header>
          {/* Containment makes the page container the containing block of fixed descendants, so nav and fixed UI stay outside */}
          <div class="page-container">
            <slot />
          </div>

          {head.show_node_switcher && (
            <div class="fixed bottom-4 left-4 z-40">
              <NodeSwitcher client:idle />
            </div>
          )}
          {import.meta.env.DEV && <DevConfigReapply client:only="solid-js" />}
          {import.meta.env.DEV && (
            <DevModeBanner client:only="solid-js" placement="page" />
          )}
        </>
      )
    }

    <!-- Event delegation for custom social links (external navigation warning) -->
    <script is:inline nonce={nonce}>
      document.addEventListener("click", function (e) {
        const link = e.target.closest("[data-custom-link]");
        if (link) {
          e.preventDefault();
          const url = link.dataset.customLink;
          if (
            url &&
            confirm("You are leaving this site. Continue to " + url + "?")
          ) {
            window.open(url, "_blank", "noopener,noreferrer");
          }
        }
      });
    </script>
  </body>
</html>
