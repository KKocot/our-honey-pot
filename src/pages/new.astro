import Layout from "../layouts/Layout.astro";
import { get_hive_username } from "../lib/config";
import { PostCreator } from "../components/post/PostCreator";

const hiveUsername = get_hive_username();
---

<Layout title={`New Post - ${hiveUsername || "Community"}`}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <a
      href="/"
      class="inline-flex items-center text-primary hover:text-primary-hover mb-6 transition-colors"
    >
      <svg
        class="w-4 h-4 mr-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"
        />
      </svg>
      Back to community
    </a>

    <h1 class="text-3xl font-bold text-text mb-8">Create New Post</h1>

    {hiveUsername ? (
      <PostCreator client:only="solid-js" community_name={hiveUsername} />
    ) : (
      <div class="text-center py-12 bg-bg-card rounded-xl shadow-sm border border-border">
        <p class="text-text-muted">
          Community is not configured. Set the HIVE_USERNAME environment
          variable of the container
        </p>
      </div>
    )}
  </div>
</Layout>
