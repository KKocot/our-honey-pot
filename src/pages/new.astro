import Layout from "../layouts/Layout.astro";
import { get_hive_username, is_community } from "../lib/config";
import { load_config_with_status } from "../lib/config-pipeline";
import { t } from "../lib/i18n";
import { PostCreator } from "../components/post/PostCreator";
import { fetch_community } from "../lib/queries";
import { resolve_instance_settings } from "../lib/instance-overrides";
import { resolveSiteName } from "../shared/components/header/utils";
import { MAIN_SECTION_ID } from "../components/admin/types/layout";

const hiveUsername = get_hive_username();

const loaded = hiveUsername
  ? await load_config_with_status(hiveUsername, is_community(hiveUsername))
  : null;
// On a read error Layout keeps its own default-theme fallback, so the defaults are not passed down.
const settings =
  loaded && loaded.status !== "error" ? loaded.settings : undefined;
const locale = loaded?.settings.locale;
const pageTitle = t(locale, "new_post.page_title", {
  name: hiveUsername || t(locale, "new_post.default_name"),
});

// Same top bar name and nav as index.astro and p/[slug].astro.
let community_title = "";
if (hiveUsername && settings && !settings.siteName) {
  try {
    community_title = (await fetch_community(hiveUsername))?.title ?? "";
  } catch {
    community_title = "";
  }
}
const site_name = settings
  ? resolveSiteName(
      {
        ...settings,
        hiveUsername: settings.hiveUsername || hiveUsername || undefined,
      },
      { community_title },
    )
  : undefined;
const topbar_nav = settings
  ? resolve_instance_settings(settings, MAIN_SECTION_ID, "navigation")
  : undefined;
---

<Layout
  title={pageTitle}
  siteName={site_name}
  nav={topbar_nav}
  settings={settings}
>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <a
      href="/"
      class="inline-flex items-center text-primary hover:text-primary-hover mb-6 transition-colors"
    >
      <svg
        class="w-4 h-4 mr-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"
        />
      </svg>
      {t(locale, "new_post.back")}
    </a>

    <h1 class="text-3xl font-bold text-text mb-8">
      {t(locale, "new_post.heading")}
    </h1>

    {hiveUsername ? (
      <PostCreator client:only="solid-js" community_name={hiveUsername} />
    ) : (
      <div class="text-center py-12 bg-bg-card rounded-xl shadow-sm border border-border">
        <p class="text-text-muted">{t(locale, "new_post.not_configured")}</p>
      </div>
    )}
  </div>
</Layout>
