import Layout from "../layouts/Layout.astro";
import { AdminPanel } from "../components/admin";
import { load_config_with_status } from "../lib/config-pipeline";
import { config_error_message } from "../components/admin/hive-broadcast";
import { get_hive_username } from "../lib/config";

const hiveUsername = get_hive_username();

// Read once per request; Layout gets the same settings instead of reading the config again
const loaded = await load_config_with_status(hiveUsername, true);
const configError =
  loaded.status === "error" ? config_error_message(loaded.error) : null;
const configAccount = loaded.status === "error" ? null : loaded.config_account;
if (loaded.status === "error") {
  console.error(
    `Admin: failed to load config from Hive: ${loaded.error.message}`,
  );
}
---

<Layout
  title={`Admin Panel - ${hiveUsername || "Hive Community"}`}
  settings={loaded.settings}
  stickyNav={false}
>
  <h1 class="sr-only">Community Admin Panel</h1>

  <AdminPanel
    client:only="solid-js"
    initialSettings={configError ? null : loaded.settings}
    ownerUsername={hiveUsername}
    configAccount={configAccount}
    configError={configError}
  />
</Layout>
