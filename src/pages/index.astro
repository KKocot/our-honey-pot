import Layout from "../layouts/Layout.astro";
import { get_hive_username } from "../lib/config";
import { prepare_community_page } from "../lib/ssr/prepare-community-page";

import { CommunityContent } from "../components/community/CommunityContent";

import SlotRenderer from "../components/home/blog/SlotRenderer.astro";
import { resolve_main_posts_settings } from "../lib/instance-overrides";
import type { SettingsData } from "../components/admin/types/settings";
import {
  type SiteSettings,
  type PageSlotPosition,
  defaultCommunityPageLayout,
  defaultCommunityPageLayoutConfig,
  type PageLayoutConfig,
} from "../components/home/types";
import {
  hasLeftSidebar as templateHasLeft,
  hasRightSidebar as templateHasRight,
  pageLayoutConfigToLegacy,
  migratePageLayoutConfigV2ToV3,
} from "../components/admin/types/layout";

// ============================================
// SSR Data Preparation
// ============================================

const hiveUsername = get_hive_username();
const url = new URL(Astro.request.url);

const community_page = hiveUsername
  ? await prepare_community_page(hiveUsername, {
      sort: url.searchParams.get("sort") || undefined,
      start_author: url.searchParams.get("start_author") || undefined,
      start_permlink: url.searchParams.get("start_permlink") || undefined,
    })
  : null;

const settings: SiteSettings = community_page?.settings ?? {};
const dehydrated_state = community_page?.dehydrated_state ?? null;
const error = community_page?.error ?? null;

// ============================================
// Settings with defaults
// ============================================

const communityTitle = community_page?.community_data?.title || hiveUsername;
const siteName = settings.siteName || communityTitle || "Hive Community";
const siteDescription =
  settings.siteDescription ||
  community_page?.community_data?.about ||
  "Hive community";

// Resolve page layout config
const defaultConfig = defaultCommunityPageLayoutConfig;

function resolvePageLayoutConfig(): PageLayoutConfig {
  const raw = settings.pageLayoutConfig;
  // v3: has containers
  if (raw?.template && raw?.containers) {
    return raw as PageLayoutConfig;
  }
  // v2: has template + sidebarLeft/sidebarRight (no containers)
  if (raw?.template && "sidebarLeft" in raw) {
    return migratePageLayoutConfigV2ToV3(raw as any);
  }
  return defaultConfig;
}

const pageLayoutConfig: PageLayoutConfig = resolvePageLayoutConfig();

// Convert to legacy format for SlotRenderer compatibility
const pageLayout = pageLayoutConfigToLegacy(pageLayoutConfig);

// Group sections by slot position
const sectionsBySlot: Record<PageSlotPosition, typeof pageLayout.sections> = {
  top: [],
  "sidebar-left": [],
  main: [],
  "sidebar-right": [],
  bottom: [],
};
pageLayout.sections.forEach((section) => {
  if (sectionsBySlot[section.slot]) {
    sectionsBySlot[section.slot].push(section);
  }
});

const hasLeftSidebar = templateHasLeft(pageLayoutConfig.template);
const hasRightSidebar = templateHasRight(pageLayoutConfig.template);
const hasSidebars = hasLeftSidebar || hasRightSidebar;

const showHeader = settings.showHeader !== false;

// Same resolver as prepare_community_page, so posts_limit in the query key matches between SSR and the island.
// The resolver only spreads its input and reads instanceOverrides, so the partial SSR config is safe to pass.
const mainPostsSettings: SiteSettings = resolve_main_posts_settings(
  settings as SettingsData,
);

// Unpack community data
const communityData = community_page?.community_data ?? null;
// Any SSR error leaves the community unconfirmed, so the islands refetch it instead of treating it as missing.
const communityFailed = Boolean(hiveUsername && !communityData && error);
const communitySortOrder = community_page?.community_sort_order ?? "trending";
const postsLimit = community_page?.posts_limit ?? 20;

// Common props for SlotRenderer
const slotRendererProps = {
  siteName,
  siteDescription,
  showHeader,
  hiveUsername,
  settings,
  communityData,
  communityFailed,
  // Community mode has no account blog data; SlotRenderer still requires the blog-mode props.
  blogLogicPosts: [],
  hiveComments: [],
  activeTab: "",
  showCommentsTab: false,
  showAuthorProfile: false,
  authorProfileBaseProps: {
    username: hiveUsername,
    account: null,
    profile: null,
    globalProperties: null,
    accountManabars: null,
    profileLayout: settings.authorProfileLayout2,
    socialLinks: settings.socialLinks,
  },
  isCategory: false,
  activeCategoryTag: null,
  totalFetchedBeforeFilter: 0,
  showCategoryLimitWarning: false,
  isFirstPage: true,
  hasMorePosts: false,
  nextPostsPageUrl: null,
  hasMoreComments: false,
  nextCommentsPageUrl: null,
};
---

<Layout title={siteName} settings={settings}>
  <div class="max-w-7xl mx-auto px-4 py-16">
    {error && (
      <div
        role="alert"
        class="flex flex-wrap items-center justify-between gap-3 bg-error/10 border border-error/30 text-error px-4 py-3 rounded-lg mb-6"
      >
        <p><strong>Error:</strong> {error}</p>
        <a
          href={url.pathname + url.search}
          class="px-4 py-2 bg-primary text-primary-text rounded-lg hover:bg-primary-hover transition-colors"
        >
          Retry
        </a>
      </div>
    )}

    {!hiveUsername && !error && (
      <div class="text-center py-12 bg-bg-card rounded-xl shadow-sm border border-border">
        <p class="text-text mb-2">Hive community name is not configured.</p>
        <p class="text-text-muted">
          Set the HIVE_USERNAME environment variable of the container (must be
          hive-XXXXXX format)
        </p>
      </div>
    )}

    {hiveUsername && (
      <>
        {/* Top sections */}
        <SlotRenderer
          sections={sectionsBySlot["top"]}
          context="top"
          {...slotRendererProps}
        />

        {/* Main content with optional sidebars */}
        {hasSidebars ? (
          <div class="sidebar-layout">
            {/* Left Sidebar */}
            {hasLeftSidebar && (
              <aside class="sidebar-left" style="--sidebar-width: 280px;">
                <SlotRenderer
                  sections={sectionsBySlot["sidebar-left"]}
                  context="sidebar-left"
                  {...slotRendererProps}
                />
              </aside>
            )}

            {/* Main Content */}
            <main class="main-content">
              {dehydrated_state && (
                <div class="js-only">
                  <CommunityContent
                    client:only="solid-js"
                    community_name={hiveUsername}
                    initial_sort={communitySortOrder}
                    posts_per_page={postsLimit}
                    settings={mainPostsSettings}
                    dehydrated_state={dehydrated_state}
                    post_card_layout={settings.postCardLayout}
                  />
                </div>
              )}
              {!dehydrated_state && (
                <div class="text-center py-12 bg-bg-card rounded-xl shadow-sm border border-border">
                  <p class="text-text-muted">Loading community...</p>
                </div>
              )}
            </main>

            {/* Right Sidebar */}
            {hasRightSidebar && (
              <aside class="sidebar-right" style="--sidebar-width: 280px;">
                <SlotRenderer
                  sections={sectionsBySlot["sidebar-right"]}
                  context="sidebar-right"
                  {...slotRendererProps}
                />
              </aside>
            )}
          </div>
        ) : (
          /* No sidebars */
          <>
            {dehydrated_state && (
              <div class="js-only">
                <CommunityContent
                  client:only="solid-js"
                  community_name={hiveUsername}
                  initial_sort={communitySortOrder}
                  posts_per_page={postsLimit}
                  settings={mainPostsSettings}
                  dehydrated_state={dehydrated_state}
                  post_card_layout={settings.postCardLayout}
                />
              </div>
            )}
            {!dehydrated_state && (
              <div class="text-center py-12 bg-bg-card rounded-xl shadow-sm border border-border">
                <p class="text-text-muted">Loading community...</p>
              </div>
            )}
          </>
        )}

        {/* Bottom sections */}
        <SlotRenderer
          sections={sectionsBySlot["bottom"]}
          context="bottom"
          {...slotRendererProps}
        />
      </>
    )}
  </div>
</Layout>
