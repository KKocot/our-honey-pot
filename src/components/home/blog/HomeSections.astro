// Custom home sections of the main column, above or below the posts island; same renderer as the /admin canvas
// (ADR 6ac6089d). Sections placed in a layout container render in its slot (SlotRenderer), never here; the main
// filter below guards callers that pass unsplit lists (index.astro already splits via split_home_sections).
import {
  home_priority_section_id,
  render_section_html,
  type HomeSection,
  type SectionRenderSettings,
} from "../../../shared/components/sections";
import { resolve_section_container } from "../../../shared/components/sections/render";

interface Props {
  sections: HomeSection[];
  settings: SectionRenderSettings;
  position: "before" | "after";
  locale?: unknown;
}

const { sections, settings, position, locale } = Astro.props;
const priority_id = home_priority_section_id(settings);
const html = sections
  .filter((section) => resolve_section_container(section, settings) === "main")
  .map((section) =>
    render_section_html(section, settings, locale, {
      priority: section.id === priority_id,
    }),
  )
  .filter((section_html) => section_html.length > 0)
  .join("");
const position_class =
  position === "before" ? "home-sections-before" : "home-sections-after";
---

{html && <div class={`home-sections ${position_class}`} set:html={html} />}
