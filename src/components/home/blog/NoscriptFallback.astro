/**
 * SSR fallback content for no-JS users
 * Renders posts or comments based on activeTab
 */
import type { BridgePost, BridgeComment } from "@hiveio/workerbee/blog-logic";
import { get_hive_username } from "../../../lib/config";
import { format_date } from "../../../lib/i18n";

interface Props {
  active_tab: string;
  blog_logic_posts: readonly BridgePost[];
  hive_comments: readonly BridgeComment[];
  locale?: string;
}

const { active_tab, blog_logic_posts, hive_comments, locale } = Astro.props;
const NUMERIC_DATE: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "numeric",
  day: "numeric",
};
const hive_username = get_hive_username();
---

{/* Static fallback for no-JS - render posts directly without interactive components */}
{active_tab !== "comments" && blog_logic_posts.length > 0 && (
  <div class="flex flex-col gap-4">
    {blog_logic_posts.map((post) => (
      <article class="bg-bg-card border border-border p-6 rounded-2xl">
        <h2 class="font-bold text-text mb-2 text-heading-4">
          <a
            href={
              post.author !== hive_username
                ? `/${post.author}/${post.permlink}`
                : `/${post.permlink}`
            }
            class="hover:text-primary transition-colors"
          >
            {post.title}
          </a>
        </h2>
        <div class="text-text-muted text-sm">
          by {post.author} • {format_date(locale, post.created, NUMERIC_DATE)}
        </div>
      </article>
    ))}
  </div>
)}
{active_tab === "comments" && hive_comments.length > 0 && (
  <div class="flex flex-col gap-4">
    {hive_comments.map((comment) => (
      <article class="bg-bg-card border border-border p-4 rounded-xl">
        <div class="text-text-muted text-sm mb-2">
          @{comment.author} • {format_date(locale, comment.created, NUMERIC_DATE)}
        </div>
        <div class="text-text">
          {(comment.body ?? "").replace(/<[^>]*>/g, "").substring(0, 200)}...
        </div>
      </article>
    ))}
  </div>
)}
