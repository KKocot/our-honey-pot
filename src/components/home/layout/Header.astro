import {
  createHeaderData,
  renderSiteHeader,
  type HeaderBrand,
} from "../../../shared/components/header";
import type { PageSlotPosition } from "../../../shared/components/page-layout/types";

interface Props {
  siteName: string;
  siteDescription: string;
  brand?: HeaderBrand;
  /** False when the home hero owns the page H1. */
  siteNameHeading?: boolean;
  /** Page slot of the header; picks the same variant as SlotRenderer and the canvas. */
  placement?: PageSlotPosition;
}

const {
  siteName,
  siteDescription,
  brand,
  siteNameHeading = true,
  placement = "top",
} = Astro.props;
const data = {
  ...createHeaderData(siteName, siteDescription, brand),
  site_name_heading: siteNameHeading,
};
const html = renderSiteHeader(data, placement);
---

<Fragment set:html={html} />
