import {
  createHeaderData,
  renderHeader,
  type HeaderBrand,
} from "../../../shared/components/header";

interface Props {
  siteName: string;
  siteDescription: string;
  brand?: HeaderBrand;
  /** False when the home hero owns the page H1. */
  siteNameHeading?: boolean;
}

const { siteName, siteDescription, brand, siteNameHeading = true } = Astro.props;
const data = {
  ...createHeaderData(siteName, siteDescription, brand),
  site_name_heading: siteNameHeading,
};
const html = renderHeader(data);
---

<Fragment set:html={html} />
