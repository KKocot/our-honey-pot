import {
  createHeaderData,
  renderHeader,
  type HeaderBrand,
} from "../../../shared/components/header";

interface Props {
  siteName: string;
  siteDescription: string;
  brand?: HeaderBrand;
}

const { siteName, siteDescription, brand } = Astro.props;
const data = createHeaderData(siteName, siteDescription, brand);
const html = renderHeader(data);
---

<Fragment set:html={html} />
