import {
  renderFooter,
  createFooterSettings,
} from "../../../shared/components/footer";
import {
  createFooterRenderInput,
  type FooterSourceSettings,
} from "../../../shared/components/footer/utils";

interface Props {
  class?: string;
  settings: FooterSourceSettings;
  site_name: string;
  year?: number;
}

const {
  class: className = "",
  settings,
  site_name,
  year = new Date().getFullYear(),
} = Astro.props;
// Same input builder as SlotRenderer.astro, so the post page footer matches the homepage one.
const input = createFooterRenderInput(settings, site_name, year);
const footer_settings = createFooterSettings({ class: className });
const html = renderFooter(input.data, footer_settings, input.owner, input.locale);
---

<div set:html={html} />
