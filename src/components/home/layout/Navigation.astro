/**
 * Navigation component using shared utilities
 */
import type { NavigationTabConfig } from "../../../shared/components/navigation";
import type { Cta, Link } from "../../admin/types/navigation";
import {
  createNavigationSettings,
  renderNavigation,
  hasNavigationContent,
} from "../../../shared/components/navigation";

interface Props {
  activeTab?: string;
  postsCount?: number;
  commentsCount?: number;
  navigationTabs?: NavigationTabConfig[];
  links?: Link[];
  cta?: Cta;
  locale?: string;
  menuId?: string;
}

const {
  activeTab = "posts",
  postsCount = 0,
  commentsCount = 0,
  navigationTabs,
  links,
  cta,
  locale,
  menuId,
} = Astro.props;

const showNavigation = hasNavigationContent({
  tabs: navigationTabs,
  links,
  cta,
});

const navSettings = showNavigation
  ? createNavigationSettings({
      navigationTabs,
      activeTab,
      postsCount,
      commentsCount,
      links,
      cta,
      locale,
      menuId,
    })
  : null;

const navigationHtml = navSettings ? renderNavigation(navSettings) : "";
---

{showNavigation && <Fragment set:html={navigationHtml} />}
